# Local development defaults. Do not commit access tokens or production secrets.
SPRING_CLOUD_CONSUL_HOST=consul
SPRING_CLOUD_CONSUL_PORT=8500
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/library-system
